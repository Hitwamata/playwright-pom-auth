{
  "name": "playwright-pom-auth",
  "version": "1.0.0",
  "description": "Projeto demo de automação E2E com Playwright, TypeScript, Page Object Model e autenticação reutilizável",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test --grep @smoke",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t playwright-pom-auth .",
    "docker:test": "docker run --rm playwright-pom-auth"
  },
  "author": "Eliazel Hitwamata",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "typescript": "^7.0.2"
  }
}
